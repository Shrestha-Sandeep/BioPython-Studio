  "review": {
    "id": "P02-REVIEW",
    "prove_solution": "parts = acquisition_id.split(\"~\")\nif len(parts) != 3:\n    decision = 'REJECT'\n    reason = 'invalid shape'\nelse:\n    strain, code, condition = parts\n    if not strain.isascii() or not strain.isalnum():\n        decision = 'REJECT'\n        reason = 'invalid strain'\n    elif not (len(code) == 3 and code.startswith('S') and code.removeprefix('S').isascii() and code.removeprefix('S').isdigit()):\n        decision = 'REJECT'\n        reason = 'invalid site'\n    elif condition not in ('control', 'heat', 'recovery'):\n        decision = 'REJECT'\n        reason = 'unknown condition'\n    elif not 0 <= focus_metric <= 1:\n        decision = 'REJECT'\n        reason = 'metric outside range'\n    elif focus_metric < focus_minimum:\n        decision = 'REJECT'\n        reason = 'metric below minimum'\n    else:\n        decision = 'ACCEPT'\n        reason = 'accepted'\naudit = f'{acquisition_id} | {decision} | {reason}'\nprint(audit)",
    "prove_checks": [
      {
        "inputs": {
          "acquisition_id": "N2~S03~control",
          "focus_metric": 0.8,
          "focus_minimum": 0.8
        },
