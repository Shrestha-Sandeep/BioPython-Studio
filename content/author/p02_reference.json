      "apply_solution": "parts = sample_id.split('_')\nif len(parts) != 3:\n    decision, reason = 'REJECT', 'wrong number of fields'\nelif parts[0] == '' or parts[1] == '' or parts[2] == '':\n    decision, reason = 'REJECT', 'empty field'\nelif focus_score < minimum_focus:\n    decision, reason = 'REJECT', 'focus below minimum'\nelse:\n    decision, reason = 'ACCEPT', 'shape and focus pass'",
