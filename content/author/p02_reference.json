  "capstone": {
    "id": "P02-CAPSTONE",
    "apply_solution": "parts = sample_id.split(\"_\")\nif len(parts) != 3:\n    decision = 'REJECT'\n    reason = 'expected three fields'\nelse:\n    strain, code, condition = parts\n    if not strain.isascii() or not strain.isalnum():\n        decision = 'REJECT'\n        reason = 'invalid strain'\n    elif not (len(code) == 3 and code.startswith('P') and code.removeprefix('P').isascii() and code.removeprefix('P').isdigit()):\n        decision = 'REJECT'\n        reason = 'invalid plate'\n    elif condition not in ('control', 'heat', 'recovery'):\n        decision = 'REJECT'\n        reason = 'unknown condition'\n    elif not 0 <= focus_score <= 1:\n        decision = 'REJECT'\n        reason = 'focus outside range'\n    elif focus_score < minimum_focus:\n        decision = 'REJECT'\n        reason = 'focus below minimum'\n    else:\n        decision = 'ACCEPT'\n        reason = 'accepted'\nreport = f'{sample_id} | {decision} | {reason}'\nprint(report)",
    "prove_solution": "parts = record_id.split(\"|\")\nif len(parts) != 3:\n    verdict = 'REJECT'\n    explanation = 'expected three fields'\nelse:\n    specimen, code, treatment = parts\n    if not specimen.isascii() or not specimen.isalnum():\n        verdict = 'REJECT'\n        explanation = 'invalid specimen'\n    elif not (len(code) == 3 and code.startswith('F') and code.removeprefix('F').isascii() and code.removeprefix('F').isdigit()):\n        verdict = 'REJECT'\n        explanation = 'invalid acquisition'\n    elif treatment not in ('control', 'heat', 'recovery'):\n        verdict = 'REJECT'\n        explanation = 'unknown treatment'\n    elif not 0 <= quality_score <= 1:\n        verdict = 'REJECT'\n        explanation = 'quality outside range'\n    elif quality_score < threshold:\n        verdict = 'REJECT'\n        explanation = 'quality below minimum'\n    else:\n        verdict = 'ACCEPT'\n        explanation = 'accepted'\nresult_line = f'{record_id} -> {verdict} ({explanation})'\nprint(result_line)",
